<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Sidekick</string>
	<key>CFBundleDisplayName</key>
	<string>Sidekick</string>
	<key>CFBundleIdentifier</key>
	<string>local.sidekick.bar</string>
	<key>CFBundleExecutable</key>
	<string>SidekickBar</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Resources/AppIcon.icns, built from AppIcon.svg by make icon -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- CFBundleShortVersionString / CFBundleVersion: written from package.json by the Makefile -->
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<!-- Menu bar only: no Dock icon, no main window -->
	<key>LSUIElement</key>
	<true/>
	<!-- The panel is served by the local daemon over plain http on 127.0.0.1 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
